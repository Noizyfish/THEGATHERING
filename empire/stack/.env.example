# NOIZY Empire stack — copy to .env (gitignored) and fill in.

# ── Forgejo ───────────────────────────────────────────────────
FORGEJO_URL=http://localhost:3000
# Create in Forgejo UI: Settings → Applications → Generate token (repo + organization scopes)
FORGEJO_TOKEN=
# Forgejo user/org that will own the mirrors
FORGEJO_OWNER=noizy
MIRROR_INTERVAL=8h

# ── GitHub ────────────────────────────────────────────────────
# Fine-grained PAT with read access to private repos (needed for private mirrors)
GITHUB_TOKEN=

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── n8n ───────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
# Shared secret the Gabriel App Intents send in X-Noizy-Key
# openssl rand -hex 24
INTENT_SHARED_SECRET=
TZ=America/Toronto

# Where the workflow fetches the manifest (override for a Forgejo-hosted copy)
EMPIRE_MANIFEST_URL=https://raw.githubusercontent.com/Noizyfish/THEGATHERING/main/empire/repos.json

# Published by the nightly launchd job on the M2 Ultra (scripts/gather-local.sh → git push)
EMPIRE_LOCAL_INVENTORY_URL=https://raw.githubusercontent.com/Noizyfish/THEGATHERING/main/empire/local-inventory.json

# Google inventory (written by the n8n "Google Inventory" workflow, or scripts/gather-google.sh)
EMPIRE_GOOGLE_INVENTORY_URL=https://raw.githubusercontent.com/Noizyfish/THEGATHERING/main/empire/google-inventory.json
# Hub repo the Google workflow commits into (GITHUB_TOKEN needs contents:write on it)
EMPIRE_HUB=Noizyfish/THEGATHERING
