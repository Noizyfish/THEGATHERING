{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "NOIZYBEAST main window: ENGR + python engine as sidecars, hub/OSC on LAN, open studio URLs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    { "identifier": "http:default", "allow": [{ "url": "http://127.0.0.1:*" }, { "url": "http://GOD.local:*" }, { "url": "http://localhost:*" }, { "url": "https://api.anthropic.com" }] },
    { "identifier": "shell:allow-execute", "allow": [
        { "name": "engr",      "cmd": "$HOME/THEGATHERING/engr/engr", "args": true },
        { "name": "noizystdz", "cmd": "$HOME/THEGATHERING/noizystdz/noizystdz", "args": true },
        { "name": "empire",    "cmd": "$HOME/THEGATHERING/scripts/empire", "args": true },
        { "name": "rustdesk",  "cmd": "/Applications/RustDesk.app/Contents/MacOS/RustDesk", "args": true },
        { "name": "open-stage-control", "cmd": "open-stage-control", "args": true }
    ] },
    "shell:allow-open"
  ]
}
