{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOIZYBEAST.IDE",
  "version": "0.1.0",
  "identifier": "ai.noizy.noizybeast",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "NOIZYBEAST.IDE", "width": 1480, "height": 940, "minWidth": 1024, "minHeight": 700, "titleBarStyle": "Overlay", "hiddenTitle": true, "theme": "Dark" }],
    "security": { "csp": "default-src 'self' http://localhost:* http://127.0.0.1:* http://GOD.local:* ws://GOD.local:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:* http://GOD.local:* http://localhost:*" }
  },
  "bundle": { "active": true, "targets": ["dmg", "app"], "icon": ["icons/icon.icns"], "macOS": { "minimumSystemVersion": "14.0", "entitlements": "entitlements.plist" } },
  "plugins": {}
}
