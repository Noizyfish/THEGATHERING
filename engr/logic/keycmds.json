{
  "$comment": "Logic Pro default (US) key commands used by ENGR. keystroke + modifiers for System Events. Verify in Logic Pro → Key Commands → Edit; export your preset here if different.",
  "play_stop":           { "key": "space" },
  "stop":                { "key": "0", "keypad": true },
  "record":              { "key": "r" },
  "go_to_start":         { "key": "return" },
  "cycle":               { "key": "c" },
  "metronome":           { "key": "k" },
  "new_audio_track":     { "key": "a", "mods": ["option", "command"] },
  "new_track_dialog":    { "key": "n", "mods": ["option", "command"] },
  "import_audio":        { "key": "i", "mods": ["shift", "command"] },
  "import_fcpxml":       { "menu": ["File", "Import", "Final Cut Pro XML…"] },
  "bounce":              { "key": "b", "mods": ["command"] },
  "save":                { "key": "s", "mods": ["command"] },
  "save_as":             { "key": "s", "mods": ["shift", "command"] },
  "new_project":         { "key": "n", "mods": ["command"] },
  "create_marker":       { "key": "'", "mods": ["option"] },
  "strip_silence":       { "key": "x", "mods": ["control"] },
  "mute_track":          { "key": "m" },
  "solo_track":          { "key": "s" },
  "mixer":               { "key": "x" },
  "capture_recording":   { "key": "r", "mods": ["shift"] },
  "rename_track":        { "key": "return", "mods": ["shift"] },
  "zoom_fit":            { "key": "z" }
}
