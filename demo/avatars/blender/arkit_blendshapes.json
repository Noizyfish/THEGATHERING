  "_idle": "Micro-motion layered under everything so the avatar never looks dead: blink every 3–6 s, breathing on jawOpen/cheek, saccades on eyeLook*.",
  "idle": { "blinkIntervalSec": [3.0, 6.0], "blinkDurationSec": 0.14, "saccadeAmplitude": 0.08, "breathAmplitude": 0.02 },
  "_wire": "UDP JSON packet, 60 Hz: {\"t\": <unix ms>, \"id\": \"lucy|gabriel\", \"w\": [52 floats 0..1], \"head\": [pitch, yaw, roll] radians}",
